# Proyecto de Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave pública (publishable / anon). Viaja al browser; sin sesión no da acceso a nada.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Clave secreta (secret / service_role). SOLO servidor: se saltea RLS.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Opcional: nombre del bucket de replays (por defecto "replays")
# SUPABASE_REPLAYS_BUCKET=replays
