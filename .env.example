# Supabase project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Public key (publishable / anon). Sent to the browser; grants nothing beyond RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Secret key (secret / service_role). Server only: it bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Optional: replays bucket name (default "replays")
# SUPABASE_REPLAYS_BUCKET=replays

# Optional: the site's public URL, used for link previews (Open Graph).
# Detected automatically on Vercel.
# NEXT_PUBLIC_SITE_URL=https://lide.example.com
