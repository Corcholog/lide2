# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# replays reales: pesados (12-17 MB c/u) y con PUUIDs y Riot IDs de gente real.
# Solo se commitean los fixtures anonimizados que genera scripts/make-fixture.ts
*.rofl
!fixtures/*.fixture.rofl

# artefactos de la CLI de supabase
supabase/.temp

# generado por npm run db:sql
supabase/all-migrations.sql
!.env.example

# logos de universidad tal como los manda cada una: formatos mezclados, uno con
# la extension cambiada y otro en mayusculas. No los usa el sitio —lo que se
# sirve es public/universidades/, que si va al repo— sino que son la entrada de
# scripts/normalize-logos.ts. Ojo: sin esta carpeta el script no se puede
# volver a correr desde un clon limpio; para agregar una universidad nueva hay
# que conseguir de nuevo los originales.
assets/universidades/
