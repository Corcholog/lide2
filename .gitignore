# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Real replays: 12-17 MB each and contain real players' PUUIDs and Riot IDs.
# Only the anonymized fixtures generated by scripts/make-fixture.ts are committed.
*.rofl
!fixtures/*.fixture.rofl

# Signup sheets: legal names of real people. Read by scripts/seed-lide2.ts.
private/

# Supabase CLI artifacts
supabase/.temp

# Generated by npm run db:sql
supabase/all-migrations.sql

# University logos as received (mixed formats, one with the wrong extension).
# The site serves the normalized copies in public/universidades/; these are the
# input of scripts/normalize-logos.ts, which cannot be re-run from a clean clone
# without them.
assets/universidades/
